# PostgreSQL configuration used when running via docker-compose
# Chaos Monkey and management configuration for local containers
SPRING_PROFILES_ACTIVE=chaos-monkey
MANAGEMENT_SERVER_ADDRESS=0.0.0.0
MANAGEMENT_SERVER_PORT=8082
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,chaosmonkey
MANAGEMENT_ENDPOINT_CHAOSMONKEY_ACCESS=unrestricted
CHAOS_MONKEY_ENABLED=false
CHAOS_MONKEY_WATCHER_SERVICE=true
CHAOS_MONKEY_WATCHER_CONTROLLER=false
CHAOS_MONKEY_WATCHER_REST_CONTROLLER=false
CHAOS_MONKEY_WATCHER_REPOSITORY=false
CHAOS_MONKEY_WATCHER_COMPONENT=false
CHAOS_MONKEY_ASSAULTS_LEVEL=1
CHAOS_MONKEY_ASSAULTS_LATENCY_ACTIVE=false
CHAOS_MONKEY_ASSAULTS_LATENCY_RANGE_START=5000
CHAOS_MONKEY_ASSAULTS_LATENCY_RANGE_END=5000
CHAOS_MONKEY_ASSAULTS_EXCEPTIONS_ACTIVE=false
CHAOS_MONKEY_ASSAULTS_KILL_APPLICATION_ACTIVE=false
CHAOS_MONKEY_ASSAULTS_MEMORY_ACTIVE=false
CHAOS_MONKEY_ASSAULTS_CPU_ACTIVE=false

DB_URL=jdbc:postgresql://postgres:5432/production_order_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
H2_CONSOLE_ENABLED=false
